{
  "name": "dsh-project-control",
  "version": "0.2.0",
  "description": "Durable project memory for DeepSeek Harness: layered brief injection, decision/constraint/contract store with keyword recall, compaction handoff, module binding, on-demand skill export, and a Web board.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "project-memory",
    "project-management",
    "context-management",
    "compaction",
    "skills",
    "modules"
  ],
  "author": "echothesky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echothesky/dsh-project.git"
  },
  "homepage": "https://github.com/echothesky/dsh-project#readme",
  "bugs": {
    "url": "https://github.com/echothesky/dsh-project/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
